              "screenshot_urls": [],
              "audio_urls": []
            }
          ]
        }
      },
      "next_steps": {
        "request_deletion": "https://app.easydemo.io/privacidade/solicitacao?tipo=eliminacao",
        "contact_dpo": "placeholder@easydemo.io",
        "_contact_dpo_note": "Placeholder funcional ate a contratacao formal do DPO (LGPD art. 41). Ver legal/DPO-PROCESS.md. Substituir apos contratacao.",
        "file_anpd_complaint": "https://www.gov.br/anpd/"
      }
    }
  ]
}
