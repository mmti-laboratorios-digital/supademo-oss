# =============================================================================
# EasyDemo — Worker (graphile-worker) Dockerfile
# Multi-stage: deps → build → runtime (Alpine)
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1 — deps (pnpm install completo, devDeps)
# -----------------------------------------------------------------------------
FROM node:25-alpine AS deps
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /repo
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY apps/workers/package.json ./apps/workers/
COPY packages ./packages
COPY apps/extension/package.json ./apps/extension/package.json
COPY apps/web/package.json ./apps/web/package.json
# O glob PRECISA estar quotado: sem aspas o shell expande `./packages/*` em
# argumentos separados e o pnpm os trata como pacotes a adicionar, virando
# `pnpm add` — onde `--frozen-lockfile` não existe.
RUN pnpm install --frozen-lockfile --filter workers... --filter "./packages/*"

# -----------------------------------------------------------------------------
# Stage 2 — build (tsx → node)
# -----------------------------------------------------------------------------
FROM deps AS build
WORKDIR /repo
COPY apps/workers ./apps/workers
COPY packages ./packages
RUN pnpm --filter workers build

# -----------------------------------------------------------------------------
# Stage 3 — runtime (Alpine, non-root)
# -----------------------------------------------------------------------------
FROM node:25-alpine AS runtime
LABEL org.opencontainers.image.title="easydemo-worker" \
      org.opencontainers.image.source="https://github.com/easydemo/easydemo" \
      org.opencontainers.image.licenses="Proprietary"

# Dependências de runtime: tini para sinais, curl para healthcheck
RUN apk add --no-cache tini curl

ENV NODE_ENV=production \
    NODE_OPTIONS="--enable-source-maps" \
    WORKER_CONCURRENCY=5

# ⚠️ **O worker precisa de `DIRECT_URL` no ambiente de deploy** (não só do
# `DATABASE_URL`):
#
#   - `DIRECT_URL` (app_owner, BYPASSRLS) → conexão da **fila** do
#     graphile-worker e instalação do schema `_graphile_worker.*`.
#     O graphile-worker cria as tabelas da fila com RLS habilitado e sem
#     policy — ele espera que o role da conexão seja o owner ou tenha
#     BYPASSRLS. Com o `app_user` o worker falha no boot.
#
#   - `DATABASE_URL` (app_user) → o Next.js, onde o isolamento RLS é
#     obrigatório.
#
# Sem `DIRECT_URL`, o worker tenta subir com o `DATABASE_URL` e falha com
# "permission denied for schema graphile_worker" — o erro fica no log.

# Non-root user
RUN addgroup -S easydemo && adduser -S easydemo -G easydemo
WORKDIR /app
COPY --from=build --chown=easydemo:easydemo /repo/apps/workers/dist /app/dist
COPY --from=build --chown=easydemo:easydemo /repo/apps/workers/package.json /app/package.json
COPY --from=build --chown=easydemo:easydemo /repo/packages /app/packages
COPY --from=build --chown=easydemo:easydemo /repo/node_modules /app/node_modules

USER easydemo
EXPOSE 9090

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://localhost:9090/healthz || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/index.js"]