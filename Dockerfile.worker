# =============================================================================
# DemoBR — Worker (graphile-worker) Dockerfile
# Multi-stage: deps → build → runtime (Alpine)
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1 — deps (pnpm install completo, devDeps)
# -----------------------------------------------------------------------------
FROM node:22-alpine AS deps
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /repo
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* tsconfig.json ./
COPY apps/workers/package.json ./apps/workers/
COPY packages ./packages
COPY apps/extension/package.json ./apps/extension/package.json 2>/dev/null || true
COPY apps/web/package.json ./apps/web/package.json
RUN pnpm install --frozen-lockfile --filter workers... --filter ./packages/*

# -----------------------------------------------------------------------------
# Stage 2 — build (tsx → node)
# -----------------------------------------------------------------------------
FROM deps AS build
WORKDIR /repo
COPY apps/workers ./apps/workers
COPY packages ./packages
RUN pnpm --filter workers build

# -----------------------------------------------------------------------------
# Stage 3 — runtime (Alpine, non-root)
# -----------------------------------------------------------------------------
FROM node:22-alpine AS runtime
LABEL org.opencontainers.image.title="demobr-worker" \
      org.opencontainers.image.source="https://github.com/demobr/demobr" \
      org.opencontainers.image.licenses="Proprietary"

# Dependências de runtime: tini para sinais, curl para healthcheck
RUN apk add --no-cache tini curl

ENV NODE_ENV=production \
    NODE_OPTIONS="--enable-source-maps" \
    WORKER_CONCURRENCY=5

# Non-root user
RUN addgroup -S demobr && adduser -S demobr -G demobr
WORKDIR /app
COPY --from=build --chown=demobr:demobr /repo/apps/workers/dist /app/dist
COPY --from=build --chown=demobr:demobr /repo/apps/workers/package.json /app/package.json
COPY --from=build --chown=demobr:demobr /repo/packages /app/packages
COPY --from=build --chown=demobr:demobr /repo/node_modules /app/node_modules

USER demobr
EXPOSE 9090

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://localhost:9090/healthz || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/index.js"]