# ─────────── App ───────────
# NÃO defina NODE_ENV aqui. O Next.js gerencia esse valor (`next dev` →
# development, `next build` → production) e o build avisa explicitamente
# quando encontra um valor não-padrão no ambiente.
#
# Efeito real de NODE_ENV=development vazar para `next build`: o prerender
# de `/_error` e `/404` aborta com
#   "<Html> should not be imported outside of pages/_document"
#   Export encountered an error on /_error: /404, exiting the build.
# Se o build falhar assim, cheque se você carregou o .env no shell
# (`set -a; source .env; set +a`) antes de rodar `pnpm build`.
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
PLAYER_BASE_URL=http://localhost:3000
MARKETING_BASE_URL=http://localhost:3000
LOCALE_DEFAULT=pt-BR
LOCALE_SUPPORTED=pt-BR,en

# ─────────── Database ───────────
# Convenção: Postgres do projeto roda em 55432 no host (não 5432) para
# não colidir com `postgresql@16-main` do SO. Container interno: 5432.
DATABASE_URL=postgres://app_user:CHANGEME@localhost:55432/easydemo
DIRECT_URL=postgres://app_owner:CHANGEME@localhost:55432/easydemo
DATABASE_POOL_SIZE=10

# ─────────── Auth (Clerk) ───────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/demos
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ─────────── Cloudflare R2 ───────────
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_PUBLIC=demo-public
R2_BUCKET_PRIVATE=demo-private
R2_PUBLIC_BASE_URL=http://localhost:3000/_static

# ─────────── Billing Asaas ───────────
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=xxx
ASAAS_WEBHOOK_SECRET=CHANGEME
ASAAS_PIX_ENABLED=true
ASAAS_BOLETO_ENABLED=true
ASAAS_CARD_ENABLED=true

# ─────────── Billing Stripe (fallback) ───────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=

# ─────────── AI ───────────
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# ─────────── E-mail (Resend) ───────────
RESEND_API_KEY=re_xxx
EMAIL_FROM="EasyDemo <noreply@easydemo.io>"
EMAIL_DPO="dpo@easydemo.io"

# ─────────── Error tracking (Sentry) ───────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─────────── Rate limit (Upstash) ───────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────── Analytics & cookies ───────────
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
VISITOR_COOKIE_NAME=_pk_id
VISITOR_COOKIE_TTL_DAYS=30
ANALYTICS_HASH_SALT_ROTATION_DAYS=30

# ─────────── LGPD ───────────
LGPD_LEAD_RETENTION_DAYS=90
LGPD_ANALYTICS_RETENTION_MONTHS=24
LGPD_BACKUP_RETENTION_MONTHS=12
LGPD_DSR_SLA_DAYS=15

# ─────────── Cloudflare (CDN) ───────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

# ─────────── Encryption ───────────
ENCRYPTION_KEY=replace-with-32-byte-base64-key
PII_HASH_SALT=replace-with-rotating-salt

# ─────────── Observability ───────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=easydemo-web