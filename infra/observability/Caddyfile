# =============================================================================
# DemoBR — Caddyfile (dev)
# Proxy: web em :3000 via hostname demobr.localhost (cookie SameSite-friendly)
# Em prod: usar Cloudflare DNS challenge (ver cloud-init.yaml).
# =============================================================================

# dev — HTTP puro (sem TLS) em localhost
http://demobr.localhost, http://localhost {
  reverse_proxy web:3000 {
    header_up Host {host}
    header_up X-Real-IP {remote}
    header_up X-Forwarded-For {remote}
    header_up X-Forwarded-Proto {scheme}
  }
}

# pgweb — UI Postgres (dev only)
http://pgweb.localhost {
  reverse_proxy pgweb:8081
}

